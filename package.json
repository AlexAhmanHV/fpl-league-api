{
  "name": "fpl-league-api",
  "version": "1.0.0",
  "description": "Documented API for a Fantasy Premier League mini-league, with derived stats FPL itself doesn't show.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p . && cd client && npm install && npm run build",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
